concurrent = {{ gitlab_runner_concurrent }}
check_interval = {{ gitlab_runner_check_interval }}
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ vault_gitlab_runner_token }}"
  executor = "{{ gitlab_runner_executor }}"
  limit = {{ gitlab_runner_concurrent }}
  [runners.docker]
    tls_verify = false
    image = "{{ gitlab_runner_default_image }}"
    privileged = {{ 'true' if gitlab_runner_privileged else 'false' }}
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = {{ gitlab_runner_volumes | to_json }}
    shm_size = {{ gitlab_runner_shm_size }}
{% if gitlab_runner_memory_limit | length > 0 %}
    memory = "{{ gitlab_runner_memory_limit }}"
{% endif %}
{% if gitlab_runner_cpu_shares | length > 0 %}
    cpu_shares = {{ gitlab_runner_cpu_shares }}
{% endif %}
    pull_policy = ["{{ gitlab_runner_pull_policy }}"]
  [runners.cache]
    MaxUploadedArchiveSize = 0
